<?xml version="1.0"?>
<!--
  Agent Judge size, complexity and duplication gate (maven-pmd-plugin, `verify`, main sources).
  Rules and thresholds are the java-guardrails kit's reference values (kit ab75812), with the
  reason for each beside it. They were measured on Agent Judge on 2026-11-07 (PMD 7.28.0, 14
  modules, 1,301 methods); the counts below are from that measurement.

  Policy (Owner, 2026-11-07; config/guardrails/decisions.md): PMD_MECHANISM ratchet. Each module
  allows its violation count of that day (pmd.maxAllowedViolations in its own pom, 155 in total);
  the allowance is lowered as fixes land and never raised. A new violation cannot enter: it
  exceeds the allowance. A violation is fixed in the code, never suppressed there, and there is
  no baseline file. The structural exemptions below are stated next to their rules.

  Duplication is checked by CPD (pmd:cpd-check, the cpd-gate execution in the parent pom) at 100
  tokens (cpd.minimumTokens) with zero allowance in every module, independent of the PMD
  ratchet. Measured before the gate: 22 duplicated blocks, almost all the twin EARS and RFC 2119
  parsers, juries and judges, plus the voting strategies; all were removed before the gate.
  CPD runs per module.
-->
<ruleset name="agent-judge-size-and-complexity"
         xmlns="http://pmd.sourceforge.net/ruleset/2.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://pmd.sourceforge.net/ruleset/2.0.0 https://pmd.sourceforge.io/ruleset_2_0_0.xsd">

    <description>Method and class size, complexity and parameter count for Agent Judge.</description>

    <!--
      Cognitive complexity, method, reported at 15 or more (the SonarSource default).
      The main readability rule: it charges for nesting, so a loop inside a try inside an if
      costs more than three flat ifs, and it looks inside lambdas. Measured: 44 of 1,301 methods
      (3.4%) at 15 or more, so the reference fits. The worst were the twin roster classifiers
      (81 each, removed before the gate), then JevRuntime.evaluate and VerdictSemantics.validate
      (58 each).
    -->
    <rule ref="category/java/design.xml/CognitiveComplexity">
        <properties>
            <property name="reportLevel" value="15"/>
        </properties>
    </rule>

    <!--
      Cyclomatic complexity, method, reported at 10 or more (McCabe's limit and PMD's
      default): the number of paths a test has to cover. Catches wide, flat methods that
      cognitive complexity forgives. Measured: 91 of 1,301 methods (7.0%) at 10 or more, above
      the kit's 5% fit line; the Owner accepted the reference (THRESHOLD_FIT_CYCLO: accept), so
      the excess is carried by the ratchet rather than by a higher threshold. Class total
      reported at 80 or more (PMD's default): 7 of 308 classes, the largest the diagnostics
      Interpreter at 332.
    -->
    <rule ref="category/java/design.xml/CyclomaticComplexity">
        <properties>
            <property name="methodReportLevel" value="10"/>
            <property name="classReportLevel" value="80"/>
        </properties>
    </rule>

    <!--
      Non-commenting source statements (NCSS). Method: reported at 30 or more, roughly a screen
      of code: 28 of 1,301 methods (2.2%). Class: reported at 300 or more, counting nested
      classes, so a class cannot hide its size in inner classes: 3 of 308 classes (1.0%). NCSS
      ignores comments and Javadoc, so a well-documented API type is measured by its code.

      Exemptions, class level only, each a shape rather than a name (kit constants):
      - A wire record container: a final class with no instance fields whose nested types are
        records, interfaces, enums, and classes holding nothing but static fields (constants).
        Its size is the schema's size, not code to be followed; its methods are still measured.
      - An interface: its own logic is default methods, which the method rules measure; its
        size is API surface, including nested builder types that are public API. Each nested
        class is still measured on its own.
    -->
    <rule ref="category/java/design.xml/NcssCount">
        <properties>
            <property name="methodReportLevel" value="30"/>
            <property name="classReportLevel" value="300"/>
            <property name="violationSuppressXPath"
                      value="self::ClassDeclaration[@Interface = true()] | self::ClassDeclaration[pmd-java:modifiers() = 'final'][ClassBody/RecordDeclaration][not(ClassBody/FieldDeclaration[not(pmd-java:modifiers() = 'static')])][not(ClassBody/ClassDeclaration[not(@Interface = true())][ClassBody/*[not(self::FieldDeclaration[pmd-java:modifiers() = 'static']) and not(self::ConstructorDeclaration[pmd-java:modifiers() = 'private'])]])]"/>
        </properties>
    </rule>

    <!--
      Long lambda, reported at 30 or more statements in one lambda body (nested lambdas count
      toward the outer one): the method threshold above, applied where NcssCount does not look.
      PMD's NCSS does not count the statements inside a lambda body. Measured: of 31 lambdas,
      the two twin roster classifiers had 57 statements each (6.5%, above the fit line because
      the population is small); the Owner accepted the reference (THRESHOLD_FIT_LAMBDA: accept),
      and both were removed before the gate.
    -->
    <rule name="LongLambda"
          language="java"
          message="A lambda body has 30 or more statements; give it a name: extract a method"
          class="net.sourceforge.pmd.lang.rule.xpath.XPathRule">
        <description>A lambda body with 30 or more statements, counted the way NCSS counts a method's.</description>
        <priority>3</priority>
        <properties>
            <property name="xpath">
                <value><![CDATA[
//LambdaExpression[Block][
  count(Block//(LocalVariableDeclaration | ExpressionStatement | ReturnStatement | IfStatement
      | ForStatement | ForeachStatement | WhileStatement | DoStatement | TryStatement
      | ThrowStatement | SwitchStatement | BreakStatement | ContinueStatement
      | SynchronizedStatement | YieldStatement | LocalClassStatement)) >= 30]
]]></value>
            </property>
        </properties>
    </rule>

    <!--
      Parameter list, reported at 7 or more: beyond six, the arguments are a type of their own.
      Measured: 4 of 1,255 methods and constructors (0.3%).
    -->
    <rule ref="category/java/design.xml/ExcessiveParameterList">
        <properties>
            <property name="minimum" value="7"/>
            <!--
              Exemption (kit constant): a record's constructors and its @JsonCreator factories.
              A record's components are its contract; every constructor and the
              deserialization factory restate them. Class constructors and ordinary methods
              stay measured, which is why turning a record into a class can surface a finding.
            -->
            <property name="violationSuppressXPath"
                      value="./ancestor::ConstructorDeclaration[1][parent::RecordBody] | ./ancestor::MethodDeclaration[1][parent::RecordBody][ModifierList/Annotation[@SimpleName = 'JsonCreator']]"/>
        </properties>
    </rule>

    <!--
      Considered and left out (kit decision): GodClass, TooManyMethods and ExcessivePublicCount.
      Counting methods or cohesion measures API breadth and value-object design rather than
      tangled code, and the size and complexity rules above already catch the classes they
      would flag.
    -->

</ruleset>
